[Unit]
Description=Jailbee orchestration broker
After=default.target

[Service]
Type=simple
ExecStart={jailbee_bin} _broker
Restart=on-failure
RestartSec=5s
# 75: another jailbee version was installed; start again on the new code.
SuccessExitStatus=75
RestartForceExitStatus=75
UMask=0077
KillMode=process

[Install]
WantedBy=default.target
